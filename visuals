	-- Tabs Header Container
	local tabHeader = Instance.new("Frame")
	tabHeader.Name = "TabHeader"
	tabHeader.Size = UDim2.new(1, -20, 0, 30)
	tabHeader.Position = UDim2.new(0, 10, 0, 45)
	tabHeader.BackgroundTransparency = 1
	tabHeader.Parent = mainFrame

	local tabLayout = Instance.new("UIListLayout")
	tabLayout.FillDirection = Enum.FillDirection.Horizontal
	tabLayout.SortOrder = Enum.SortOrder.LayoutOrder
	tabLayout.Padding = UDim.new(0, 6)
	tabLayout.Parent = tabHeader

	-- Content Area Container
	local contentContainer = Instance.new("Frame")
	contentContainer.Name = "ContentContainer"
	contentContainer.Size = UDim2.new(1, -20, 1, -85)
	contentContainer.Position = UDim2.new(0, 10, 0, 80)
	contentContainer.BackgroundTransparency = 1
	contentContainer.Parent = mainFrame

	local tabs = {}
	local tabButtons = {}
	local currentActiveTab = nil

	local function SwitchTab(tabName)
		for name, container in pairs(tabs) do
			container.Visible = (name == tabName)
		end
		for name, btn in pairs(tabButtons) do
			if name == tabName then
				btn.BackgroundColor3 = Color3.fromRGB(139, 0, 0)
				btn.TextColor3 = Color3.fromRGB(255, 255, 255)
			else
				btn.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
				btn.TextColor3 = Color3.fromRGB(150, 150, 150)
			end
		end
	end

	function CustomUI.AddTab(name)
		-- Tab Content Window
		local scroll = Instance.new("ScrollingFrame")
		scroll.Name = name .. "Tab"
		scroll.Size = UDim2.new(1, 0, 1, 0)
		scroll.BackgroundTransparency = 1
		scroll.BorderSizePixel = 0
		scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
		scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
		scroll.ScrollBarThickness = 4
		scroll.ScrollBarImageColor3 = Color3.fromRGB(139, 0, 0)
		scroll.Visible = false
		scroll.Parent = contentContainer

		local list = Instance.new("UIListLayout")
		list.SortOrder = Enum.SortOrder.LayoutOrder
		list.Padding = UDim.new(0, 6)
		list.Parent = scroll

		local padding = Instance.new("UIPadding")
		padding.PaddingTop = UDim.new(0, 2)
		padding.PaddingBottom = UDim.new(0, 5)
		padding.PaddingRight = UDim.new(0, 5)
		padding.PaddingLeft = UDim.new(0, 2)
		padding.Parent = scroll

		tabs[name] = scroll

		-- Tab Switcher Button
		local btn = Instance.new("TextButton")
		btn.Name = name .. "Btn"
		btn.Size = UDim2.new(0, 130, 1, 0)
		btn.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
		btn.Font = Enum.Font.GothamSemibold
		btn.Text = name
		btn.TextColor3 = Color3.fromRGB(150, 150, 150)
		btn.TextSize = 12
		btn.AutoButtonColor = false
		btn.Parent = tabHeader

		local btnCorner = Instance.new("UICorner")
		btnCorner.CornerRadius = UDim.new(0, 6)
		btnCorner.Parent = btn

		btn.MouseButton1Click:Connect(function()
			SwitchTab(name)
		end)

		tabButtons[name] = btn

		if not currentActiveTab then
			currentActiveTab = name
			SwitchTab(name)
		end

		return scroll
	end

	return CustomUI
end

