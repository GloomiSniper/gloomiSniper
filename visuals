local function scanSignature()
	clearTogglesSig()
	statusSig.Visible = false

	local animalPodiums = findPodiums()
	if not animalPodiums then
		statusSig.Text = "Waiting for your plot…"
		statusSig.Visible = true
		return
	end

	local matched = matchPodiums(animalPodiums)
	if #matched == 0 then
		statusSig.Text = "No brainrots found in your plot."
		statusSig.Visible = true
		return
	end

	for _, m in ipairs(matched) do
		local label        = m.occupied and string.format("%s | %s", m.name, m.gen) or string.format("[%s] Empty", m.podiumName)
		local initialState = m.occupied and signatureClones[m.name] ~= nil or false
		local animalName   = m.occupied and m.name     or nil
